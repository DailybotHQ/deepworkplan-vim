# Docker build context for docker/local/dwpvim (context = this repository
# root; see docker/local/docker-compose.yaml). The Dockerfile COPYs only
# docker/local/dwpvim/entrypoint.sh (the editor comes from the DeepWorkPlan
# Vim installer) — everything else is excluded to keep the context lean. .git alone dominates the tree; .env files must never enter a
# build context.
.git
.dwp
tmp
.agents
.claude
.cursor
.github
docs
tests
node_modules
compose.yml
LICENSE
*.md
!CheatSheet.md
**/.env
**/.env.*
