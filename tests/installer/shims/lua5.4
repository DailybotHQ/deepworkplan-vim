#!/usr/bin/env bash
# tests/installer/shims/lua5.4 — records the Lua-leg invocation and
# succeeds. The harness never runs the real install.lua: its package
# installs belong to the container matrix, not a bash-only host run.
# The skip switch install.sh hands to install.lua is recorded too.
[ -n "${SHIM_LOG:-}" ] && printf 'lua5.4 %s%s\n' "$*" \
  "${DWP_VIM_SKIP_PACKAGES:+ skip_packages=$DWP_VIM_SKIP_PACKAGES}" >>"$SHIM_LOG"
exit 0
